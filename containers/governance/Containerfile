# Disposable resolver and confinement images for project governance.

FROM docker.io/library/python:3.13-slim@sha256:8fef26df932191825664e4957ff488c96dfe64918327634a357a55facbc994d3 AS base

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1

RUN useradd --create-home --uid 1000 --shell /bin/bash box
COPY containers/toolbox/entrypoint.sh /usr/local/sbin/toolbox-entrypoint
COPY tools/container_payload.py /usr/local/libexec/container-payload
RUN chmod 0755 /usr/local/sbin/toolbox-entrypoint \
        /usr/local/libexec/container-payload

USER box
WORKDIR /work
ENTRYPOINT ["/usr/local/sbin/toolbox-entrypoint"]

FROM base AS lock
USER root
RUN python -m pip install --quiet --only-binary=:all: \
        pip==26.2.1 \
        setuptools==84.0.0 \
        pip-tools==7.6.1 \
        build==1.5.0 \
        click==8.4.2 \
        packaging==26.3 \
        pyproject-hooks==1.2.0 \
        wheel==0.48.0
USER box

FROM base AS confinement
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        --no-install-recommends shellcheck \
    && rm -rf /var/lib/apt/lists/*
USER box

FROM docker.io/library/python:3.13-slim@sha256:8fef26df932191825664e4957ff488c96dfe64918327634a357a55facbc994d3 AS compatibility

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1

RUN useradd --create-home --uid 1000 --shell /bin/bash box \
    && python -m pip install --quiet --only-binary=:all: \
        pip==26.2.1 \
        setuptools==84.0.0 \
        pip-tools==7.6.1 \
        build==1.5.0 \
        click==8.4.2 \
        packaging==26.3 \
        pyproject-hooks==1.2.0 \
        wheel==0.48.0
COPY containers/toolbox/entrypoint.sh /usr/local/sbin/toolbox-entrypoint
COPY tools/container_payload.py /usr/local/libexec/container-payload
RUN chmod 0755 /usr/local/sbin/toolbox-entrypoint \
        /usr/local/libexec/container-payload
USER box
WORKDIR /work
ENTRYPOINT ["/usr/local/sbin/toolbox-entrypoint"]
