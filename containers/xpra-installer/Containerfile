ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        python3 \
        sudo \
    && useradd --create-home --shell /bin/bash xpra-installer \
    && printf '%s\n' \
        'xpra-installer ALL=(ALL:ALL) NOPASSWD: ALL' \
        > /etc/sudoers.d/xpra-installer \
    && chmod 0440 /etc/sudoers.d/xpra-installer \
    && printf '%s\n' \
        'auth sufficient pam_permit.so' \
        'account sufficient pam_permit.so' \
        'session sufficient pam_permit.so' \
        > /etc/pam.d/sudo \
    && printf '%s\n' 'APT::Sandbox::User "root";' \
        > /etc/apt/apt.conf.d/99-rootless-container-sandbox \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 \
    tools/install_xpra_release.py \
    /usr/local/libexec/install_xpra_release.py

ENTRYPOINT ["/usr/bin/sleep", "infinity"]
